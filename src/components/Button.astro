---
/**
 * Button.astro — Universal button component for Margin theme
 *
 * Variants: primary | ghost | outline
 * Sizes: sm | md | lg
 * Uses slot for content (supports HTML/icons inside)
 *
 * Usage:
 *   <Button variant="primary" href="/subscribe">Subscribe</Button>
 *   <Button variant="outline" type="submit">Send</Button>
 *   <Button size="sm" variant="ghost">Cancel</Button>
 */
import Icon from './Icon.astro';

interface Props {
	variant?: 'primary' | 'ghost' | 'outline';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
	ariaLabel?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	class: className = '',
	ariaLabel,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const extraProps = href ? { href } : { type };
---

<Tag
	class={`ui-btn ui-btn-${variant} ui-btn-${size} ${className}`}
	{...(ariaLabel ? { 'aria-label': ariaLabel } : {})}
	{...extraProps}
>
	<slot />
</Tag>

<style>
	.ui-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		border-radius: 3px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		font-family: inherit;
		border: none;
		transition: all 0.2s ease;
	}

	/* Sizes */
	.ui-btn-sm { font-size: 0.8125rem; padding: 0.4rem 1rem; }
	.ui-btn-md { font-size: 0.875rem; padding: 0.6rem 1.4rem; }
	.ui-btn-lg { font-size: 1rem; padding: 0.8rem 2rem; }

	/* ── Primary: solid accent ── */
	.ui-btn-primary {
		background: var(--c-accent);
		color: #f5f0ea;
	}
	.ui-btn-primary:hover {
		background: var(--c-accent-deep);
	}

	/* ── Ghost: transparent, subtle bg on hover ── */
	.ui-btn-ghost {
		background: transparent;
		color: var(--c-muted);
	}
	.ui-btn-ghost:hover {
		background: var(--c-surface);
		color: var(--c-ink);
	}

	/* ── Outline: border, fills on hover ── */
	.ui-btn-outline {
		background: transparent;
		color: var(--c-ink);
		box-shadow: inset 0 0 0 1.5px var(--c-border-strong);
	}
	.ui-btn-outline:hover {
		border-color: var(--c-accent);
		box-shadow: inset 0 0 0 1.5px var(--c-accent);
		color: var(--c-accent-soft);
	}
</style>
