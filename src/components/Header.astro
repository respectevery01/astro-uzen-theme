---
import config from '../config.json';
---

<header class="sticky top-0 z-50 bg-[#0e0a0c]/85 backdrop-blur-xl border-b border-white/[0.07]">
	<div class="max-w-[1280px] mx-auto px-8 h-14 flex items-center justify-between">
		<!-- Left: logo + nav -->
		<div class="flex items-center gap-7">
			<a href="/" class="flex items-center gap-2 font-serif font-bold text-[18px] tracking-tight text-[#f5f0ea]">
				<span class="w-[18px] h-[18px] rounded-full bg-gradient-to-br from-[#d4324a] to-[#a52136]"></span>
				{config.siteTitle}
			</a>
			<nav class="hidden md:flex gap-5">
				{config.navigation.map(item => (
					<a href={item.href} class="text-[13px] text-[#625b58] hover:text-[#f5f0ea] transition-colors">{item.label}</a>
				))}
			</nav>
		</div>

		<!-- Right: actions -->
		<div class="flex items-center gap-3.5">
			<a href="/contact" class="hidden sm:block text-[13px] text-[#625b58] hover:text-[#f5f0ea] transition-colors">Contact</a>
			<a href="/subscribe" class="bg-[#d4324a] text-[#f5f0ea] text-[13px] font-semibold px-4 py-1.5 rounded-[3px] hover:bg-[#a52136] transition-colors no-underline">
				Subscribe
			</a>
			<!-- Mobile menu toggle -->
			<button id="mobile-menu-toggle" class="md:hidden text-[#625b58]">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<line x1="4" x2="20" y1="8" y2="8"/>
					<line x1="4" x2="20" y1="14" y2="14"/>
					<line x1="4" x2="20" y1="20" y2="20"/>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.07]">
		<nav class="flex flex-col px-8 py-4 gap-4">
			{config.navigation.map(item => (
				<a href={item.href} class="text-sm text-[#625b58] hover:text-[#f5f0ea]">{item.label}</a>
			))}
		</nav>
	</div>
</header>

<script>
	var btn = document.getElementById('mobile-menu-toggle');
	var menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
