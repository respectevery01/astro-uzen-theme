---
import config from '../config.json';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 bg-bg/85 backdrop-blur-xl border-b border-[var(--c-border)]">
	<div class="max-w-[1280px] mx-auto px-5 md:px-8 h-14 flex items-center justify-between">
		<!-- Left: logo + nav -->
		<div class="flex items-center gap-7">
			<a href="/" class="flex items-center gap-2 font-serif font-bold text-[18px] tracking-tight text-ink">
				<span class="w-[18px] h-[18px] rounded-full" style="background:linear-gradient(135deg, var(--c-accent), var(--c-accent-deep))"></span>
				{config.siteTitle}
			</a>
			<nav class="hidden md:flex gap-5">
				{config.navigation.map(item => (
					<a href={item.href} class="text-[13px] text-muted hover:text-ink transition-colors">{item.label}</a>
				))}
			</nav>
		</div>

		<!-- Right: actions -->
		<div class="flex items-center gap-2">
			<!-- Search trigger -->
			<a href="/search" class="flex items-center justify-center w-9 h-9 rounded-[3px] hover:bg-surface text-muted hover:text-ink transition-colors" aria-label="Search">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<circle cx="11" cy="11" r="8" />
					<path d="m21 21-4.35-4.35" />
				</svg>
			</a>
			<ThemeToggle />
			<a href="/subscribe" class="hidden sm:flex items-center bg-accent text-[#f5f0ea] text-[13px] font-semibold px-4 py-1.5 rounded-[3px] hover:bg-accent-deep transition-colors no-underline ml-1">
				Subscribe
			</a>
			<!-- Mobile menu toggle -->
			<button id="mobile-menu-toggle" class="md:hidden text-muted ml-1">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<line x1="4" x2="20" y1="8" y2="8"/>
					<line x1="4" x2="20" y1="14" y2="14"/>
					<line x1="4" x2="20" y1="20" y2="20"/>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-[var(--c-border)]">
		<nav class="flex flex-col px-5 py-4 gap-4">
			{config.navigation.map(item => (
				<a href={item.href} class="text-sm text-muted hover:text-ink">{item.label}</a>
			))}
			<a href="/subscribe" class="text-sm text-accent font-medium">Subscribe</a>
		</nav>
	</div>
</header>

<script>
	var btn = document.getElementById('mobile-menu-toggle');
	var menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
