---
import config from '../../config.json';

const { links } = Astro.props;

const icons: Record<string, string> = {
	twitter: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
	facebook: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
	weibo: '<path d="M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.737 5.441z"/>',
};
---

<div class="flex gap-3">
	{links.map((link: any) => (
		<a href={link.href} class="w-8 h-8 flex items-center justify-center rounded-[3px] border border-white/[0.07] text-[#625b58] hover:text-[#f2a8b3] hover:border-[#f2a8b3]/30 transition-colors" aria-label={link.label}>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
				<Fragment set:html={icons[link.icon] || ''} />
			</svg>
		</a>
	))}
</div>
