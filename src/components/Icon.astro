const isFilled = stroke === false && filled[name] !== undefined;
const path = isFilled ? filled[name] : (outline[name] || filled[name] || '');
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	<Fragment set:html={path} />
</svg>
