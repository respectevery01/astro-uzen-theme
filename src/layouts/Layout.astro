---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../config.json';

interface Props {
	title: string;
	description?: string;
}

const { title, description = config.siteDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://margin.pages.dev').toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			name: "Margin",
			url: "https://margin.pages.dev",
			description: config.siteDescription
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "Margin",
			url: "https://margin.pages.dev"
		})} />
	</head>
	<body class="bg-[#0e0a0c] text-[#9a9088] min-h-screen flex flex-col antialiased">
		<Header />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	/* ── Base ─────────────────────────────── */
	* { -webkit-font-smoothing: antialiased; }
	body {
		font-family: 'Inter', -apple-system, system-ui, sans-serif;
		line-height: 1.6;
	}
	a { color: inherit; text-decoration: none; }
	::selection {
		background: rgba(212,50,74,0.25);
		color: #f5f0ea;
	}

	/* ── Prose (article reading) ─────────── */
	.prose {
		font-family: 'Inter', sans-serif;
		max-width: 680px;
	}
	.prose h1, .prose h2, .prose h3, .prose h4 {
		font-family: 'Fraunces', serif;
		color: #f5f0ea;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.prose h2 { font-size: 1.75rem; margin-top: 2.5rem; margin-bottom: 1rem; }
	.prose h3 { font-size: 1.35rem; margin-top: 2rem; margin-bottom: 0.75rem; }
	.prose p {
		color: #9a9088;
		line-height: 1.85;
		font-size: 1.05rem;
		margin-bottom: 1.25rem;
	}
	.prose a {
		color: #f2a8b3;
		border-bottom: 1px solid rgba(242,168,179,0.3);
		transition: border-color 0.2s;
	}
	.prose a:hover { border-bottom-color: #f2a8b3; }
	.prose strong { color: #f5f0ea; font-weight: 600; }
	.prose blockquote {
		border-left: 2px solid #d4324a;
		padding-left: 1.5rem;
		margin: 1.5rem 0;
		font-style: italic;
		color: #9a9088;
	}
	.prose ul, .prose ol {
		color: #9a9088;
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}
	.prose li { margin-bottom: 0.5rem; line-height: 1.75; }
	.prose code {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.875rem;
		background: rgba(245,240,234,0.06);
		padding: 0.15rem 0.4rem;
		border-radius: 3px;
		color: #f2a8b3;
	}
	.prose pre {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.875rem;
		line-height: 1.6;
		background: #131012;
		border: 1px solid rgba(245,240,234,0.07);
		border-radius: 3px;
		padding: 1.25rem;
		overflow-x: auto;
		margin: 1.5rem 0;
	}
	.prose pre code {
		background: transparent;
		padding: 0;
		color: #f5f0ea;
	}
	.prose img {
		border-radius: 3px;
		margin: 1.5rem 0;
	}
	.prose hr {
		border: none;
		border-top: 1px solid rgba(245,240,234,0.07);
		margin: 2.5rem 0;
	}

	/* ── Scrollbar ───────────────────────── */
	::-webkit-scrollbar { width: 6px; }
	::-webkit-scrollbar-track { background: transparent; }
	::-webkit-scrollbar-thumb { background: rgba(245,240,234,0.1); border-radius: 3px; }
</style>
