---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import config from '../../config.json';

export async function getStaticPaths() {
    if (!config.enableAuthor) {
        return [];
    }
	const posts = await getCollection('posts');
    const authors = [...new Set(posts.map((post) => post.data.author))];
	return authors.map((author) => ({
		params: { author: author },
		props: { author, posts: posts.filter(post => post.data.author === author) },
	}));
}

const { author, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) => {
	const m = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${m}.${day}`;
};
---

<Layout title={`${author} - ${config.siteTitle}`} description={`Stories by ${author}.`}>
	<!-- Author header -->
	<section class="max-w-[1280px] mx-auto px-5 md:px-8 pt-10 md:pt-14 pb-10 md:pb-12">
		<div class="flex items-center gap-5 mb-6">
			<span class="w-[52px] h-[52px] rounded-full flex items-center justify-center font-serif text-[22px] font-bold text-[#f5f0ea]" style="background:linear-gradient(135deg, var(--c-accent), var(--c-accent-deep))">
				{author.charAt(0)}
			</span>
			<div>
				<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mb-1">Author</div>
				<h1 class="font-serif text-[28px] md:text-[36px] font-bold tracking-tight text-ink">{author}</h1>
			</div>
		</div>
		<p class="text-[16px] text-body max-w-[500px]">
			{sortedPosts.length} {sortedPosts.length === 1 ? 'story' : 'stories'} by this author.
		</p>
	</section>

	<!-- Grid -->
	<section class="max-w-[1280px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{sortedPosts.map((post) => (
				<article class="flex flex-col cursor-pointer group">
					<a href={`/posts/${post.slug}`} class="block aspect-[16/9] rounded-[3px] overflow-hidden bg-surface mb-4">
						{post.data.image ? (
							<img src={post.data.image.url} alt={post.data.image.alt}
								class="w-full h-full object-cover group-hover:opacity-80 transition-opacity"
								loading="lazy" />
						) : (
							<div class="w-full h-full"></div>
						)}
					</a>
					<div class="font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-accent mb-2">
						{post.data.category}
					</div>
					<h3 class="font-serif text-[19px] font-semibold leading-[1.3] tracking-tight text-ink mb-2">
						<a href={`/posts/${post.slug}`} class="group-hover:text-accent-soft transition-colors">
							{post.data.title}
						</a>
					</h3>
					<p class="text-[14px] text-muted leading-[1.55] line-clamp-2 mb-3">
						{post.data.description}
					</p>
					<div class="mt-auto flex items-center gap-2 font-mono text-[12px] text-faint">
						<span class="w-[18px] h-[18px] rounded-full" style="background:linear-gradient(135deg, var(--c-accent), var(--c-accent-deep))"></span>
						{post.data.author}
						<span class="w-[3px] h-[3px] rounded-full bg-faint"></span>
						{formatDate(post.data.pubDate)}
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>
