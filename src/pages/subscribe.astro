---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Subscribe — Margin" description="Subscribe to Margin for weekly stories worth reading.">
	<section class="max-w-[680px] mx-auto px-8 py-20 text-center">
		<div class="font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-accent mb-6">
			Newsletter
		</div>
		<h1 class="font-serif text-[36px] md:text-[48px] font-bold leading-[1.1] tracking-tight text-ink mb-4">
			One email per week.<br>
			<em class="italic font-normal text-accent-soft">No noise.</em>
		</h1>
		<p class="text-[17px] text-body leading-[1.6] mb-12 max-w-[440px] mx-auto">
			Subscribe for weekly stories on technology, design, and culture. No spam, no daily emails, no algorithm. Just writing worth your time.
		</p>

		<form class="flex gap-2 max-w-[420px] mx-auto mb-6">
			<input type="email" name="email" required placeholder="you@example.com"
				class="flex-1 bg-transparent border border-[var(--c-border-strong)] text-ink text-[15px] px-4 py-3 rounded-[3px] focus:border-accent focus:outline-none transition-colors" />
			<button type="submit"
				class="bg-accent text-[#f5f0ea] text-[14px] font-semibold px-6 py-3 rounded-[3px] hover:bg-accent-deep transition-colors whitespace-nowrap">
				Subscribe
			</button>
		</form>
		<p class="text-[12px] text-faint font-mono">
			Free. Unsubscribe anytime. No tracking.
		</p>
	</section>
</Layout>
