---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Layout title="Subscribe — Margin" description="Subscribe to Margin for weekly stories worth reading.">
	<PageHeader
		kicker="Newsletter"
		title="One email per week."
		titleEmphasis="No noise."
		desc="Subscribe for weekly stories on technology, design, and culture. No spam, no daily emails, no algorithm. Just writing worth your time."
	/>

	<section class="max-w-[680px] mx-auto px-5 md:px-8 pb-14 md:pb-20">
		<NewsletterForm compact buttonText="Subscribe" />
		<p class="text-[12px] text-faint font-mono text-center mt-6">
			Free. Unsubscribe anytime. No tracking.
		</p>
	</section>
</Layout>
