---
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
---

<Layout title="Contact — Margin" description="Get in touch with the Margin team.">
	<section class="max-w-[680px] mx-auto px-8 py-14">
		<div class="font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-accent mb-4">
			Contact
		</div>
		<h1 class="font-serif text-[36px] md:text-[42px] font-bold leading-[1.15] tracking-tight text-ink mb-6">
			Get in touch
		</h1>
		<p class="text-[16px] text-body leading-[1.7] mb-8">
			Questions, feedback, or want to contribute? Send us a message and we'll get back to you within 48 hours.
		</p>

		<form class="flex flex-col gap-5 max-w-[500px]" action="https://formspree.io/f/your-form-id" method="POST">
			<div>
				<label class="block text-[12px] font-mono uppercase tracking-[0.06em] text-muted mb-2">Name</label>
				<input type="text" name="name" required
					class="w-full bg-transparent border-b border-[var(--c-border-strong)] text-ink text-[15px] py-3 focus:border-accent focus:outline-none transition-colors"
					placeholder="Your name" />
			</div>
			<div>
				<label class="block text-[12px] font-mono uppercase tracking-[0.06em] text-muted mb-2">Email</label>
				<input type="email" name="email" required
					class="w-full bg-transparent border-b border-[var(--c-border-strong)] text-ink text-[15px] py-3 focus:border-accent focus:outline-none transition-colors"
					placeholder="you@example.com" />
			</div>
			<div>
				<label class="block text-[12px] font-mono uppercase tracking-[0.06em] text-muted mb-2">Message</label>
				<textarea name="message" required rows="5"
					class="w-full bg-transparent border-b border-[var(--c-border-strong)] text-ink text-[15px] py-3 focus:border-accent focus:outline-none transition-colors resize-none"
					placeholder="What's on your mind?"></textarea>
			</div>
			<button type="submit"
				class="self-start bg-accent text-[#f5f0ea] text-[14px] font-semibold px-6 py-2.5 rounded-[3px] hover:bg-accent-deep transition-colors mt-2">
				Send message
			</button>
		</form>
	</section>
</Layout>
