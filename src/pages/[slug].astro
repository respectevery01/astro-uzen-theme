---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
import SocialShare from '../components/SocialShare.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    return pages.map(page => ({
        params: { slug: page.slug },
        props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await page.render();
---

<Layout title={`${page.data.title} - ${config.siteTitle}`}>
    <div class="max-w-[1280px] mx-auto px-5 md:px-8 py-10 md:py-14" style="max-width:1024px">
        <header class="mb-10 md:mb-12 pb-8 border-b border-[var(--c-border)]">
            <h1 class="font-serif text-[28px] sm:text-[36px] md:text-[48px] font-bold leading-[1.1] tracking-tight text-ink mb-4">
                {page.data.title}
            </h1>
            {page.data.description && (
                <p class="text-[17px] text-body max-w-[500px]">
                    {page.data.description}
                </p>
            )}
        </header>

        <div class="prose max-w-none">
            <Content />
        </div>

        {page.data.showSocial && (
            <div class="mt-12 pt-8 border-t border-[var(--c-border)]">
                <h3 class="font-serif text-[20px] font-bold text-ink mb-4">Follow Us</h3>
                <SocialShare links={config.socialLinks} />
            </div>
        )}
    </div>
</Layout>
