---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import config from '../../config.json';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const tagMap = new Map<string, typeof posts>();

	posts.forEach(post => {
		(post.data.tags || []).forEach(tag => {
			const key = tag.toLowerCase().replace(/\s+/g, '-');
			if (!tagMap.has(key)) tagMap.set(key, []);
			tagMap.get(key)!.push(post);
		});
	});

	return Array.from(tagMap.entries()).map(([slug, posts]) => ({
		params: { tag: slug },
		props: {
			tag: posts[0].data.tags.find(t => t.toLowerCase().replace(/\s+/g, '-') === slug) || slug,
			posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<Layout title={`${tag} - ${config.siteTitle}`} description={`Posts tagged ${tag}.`}>
	<PageHeader
		kicker="Tag"
		title={`#${tag}`}
		desc={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged ${tag}.`}
	/>

	<section class="max-w-[1280px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{posts.map((post) => (
				<PostCard post={post} />
			))}
		</div>
	</section>
</Layout>
