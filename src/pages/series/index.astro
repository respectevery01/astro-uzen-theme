---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import config from '../../config.json';
import { formatDateShort } from '../../lib/dates';

const posts = await getCollection('posts');
const seriesMap = new Map<string, typeof posts>();

posts.forEach(post => {
	if (post.data.series) {
		const key = post.data.series;
		if (!seriesMap.has(key)) seriesMap.set(key, []);
		seriesMap.get(key)!.push(post);
	}
});

const allSeries = Array.from(seriesMap.entries()).map(([name, sposts]) => ({
	name,
	slug: name.toLowerCase().replace(/\s+/g, '-'),
	posts: sposts.sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0)),
}));
---

<Layout title={`Series — ${config.siteTitle}`} description="Multi-part article series and collections.">
	<PageHeader kicker="Collections" title="Series" desc={`${allSeries.length} ${allSeries.length === 1 ? 'series' : 'series'} of in-depth, multi-part stories.`} />

	<section class="max-w-[860px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div class="flex flex-col gap-8">
			{allSeries.map(s => (
				<a href={`/series/${s.slug}/`} class="series-card group">
					<!-- Top row: count + arrow -->
					<div class="flex items-center justify-between mb-3">
						<div class="flex items-center gap-2">
							<Icon name="bookmark" size={14} stroke={true} class="text-accent" />
							<span class="font-mono text-[11px] uppercase tracking-[0.12em] text-faint">
								{s.posts.length} {s.posts.length === 1 ? 'part' : 'parts'}
							</span>
						</div>
						<Icon name="arrow-up-right" size={16} stroke={true} class="text-muted group-hover:text-accent-soft transition-colors" />
					</div>

					<!-- Series name -->
					<h2 class="font-serif text-[22px] md:text-[28px] font-bold leading-[1.18] tracking-tight text-ink group-hover:text-accent-soft transition-colors mb-2">
						{s.name}
					</h2>

					<!-- Parts preview (first 3) -->
					<div class="flex flex-col gap-1.5 mt-4 pt-4 border-t border-[var(--c-border)]">
						{s.posts.slice(0, 3).map((p, i) => (
							<div class="flex items-center gap-3 text-[13px]">
								<span class="font-mono text-[10px] text-faint w-5 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
								<span class="text-muted truncate">{p.data.title}</span>
								<span class="font-mono text-[10px] text-faint flex-shrink-0">{formatDateShort(p.data.pubDate)}</span>
							</div>
						))}
						{s.posts.length > 3 && (
							<span class="font-mono text-[10px] text-faint ml-8 mt-1">+ {s.posts.length - 3} more</span>
						)}
					</div>
				</a>
			))}

			{allSeries.length === 0 && (
				<div class="text-center text-muted text-sm py-16">
					No series yet.
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.series-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid var(--c-border);
		border-radius: 3px;
		background: var(--c-surface);
		transition: border-color 0.2s;
	}
	.series-card:hover {
		border-color: var(--c-border-strong);
	}
</style>
