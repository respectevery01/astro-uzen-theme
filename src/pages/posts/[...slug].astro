---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SocialShare from '../../components/SocialShare.astro';
import config from '../../config.json';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content, headings } = await post.render();

const formatDate = (d: Date) => {
	return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

const allPosts = await getCollection('posts');
const related = allPosts
	.filter(p => p.data.category === post.data.category && p.slug !== post.slug)
	.slice(0, 3);

// TOC: only h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="max-w-[1280px] mx-auto px-8 py-14">
		<!-- Back link -->
		<a href="/" class="inline-flex items-center gap-2 text-[13px] text-muted hover:text-ink transition-colors mb-10">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M19 12H5M12 19l-7-7 7-7"/>
			</svg>
			Back to home
		</a>

		<div class="grid grid-cols-12 gap-12">
			<!-- Main column -->
			<div class="col-span-12 lg:col-span-8 lg:col-start-1">
				<!-- Article header -->
				<header class="max-w-[680px] mb-12">
					<div class="flex items-center gap-3 mb-4">
						<span class="font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-accent">
							{post.data.category}
						</span>
						<span class="font-mono text-[11px] text-faint">
							{formatDate(post.data.pubDate)}
						</span>
					</div>
					<h1 class="font-serif text-[36px] md:text-[42px] font-bold leading-[1.15] tracking-tight text-ink mb-6">
						{post.data.title}
					</h1>
					<div class="flex items-center gap-3 pt-4 border-t border-[var(--c-border)]">
						{config.enableAuthor && (
							<span class="text-[13px] text-body">
								By <a href={`/author/${post.data.author}`} class="font-medium text-ink hover:text-accent-soft transition-colors">{post.data.author}</a>
							</span>
						)}
					</div>
				</header>

				<!-- Cover image -->
				{post.data.image && (
					<div class="max-w-[800px] mb-12 rounded-[3px] overflow-hidden">
						<img src={post.data.image.url} alt={post.data.image.alt}
							class="w-full h-auto object-cover max-h-[500px]" loading="eager" />
					</div>
				)}

				<!-- Article body -->
				<div class="prose mx-auto max-w-none" style="max-width:680px;" data-pagefind-body>
					<Content />
				</div>

				<!-- Share -->
				<div class="max-w-[680px] mt-16 pt-8 border-t border-[var(--c-border)] flex items-center gap-4">
					<span class="text-[13px] text-body">Share:</span>
					<SocialShare links={config.shareLinks} />
				</div>

				<!-- Related -->
				{related.length > 0 && (
					<div class="max-w-[800px] mt-16">
						<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mb-5">Related Stories</div>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
							{related.map(r => (
								<a href={`/posts/${r.slug}`} class="block group">
									<div class="aspect-[16/9] rounded-[3px] overflow-hidden bg-surface mb-3">
										{r.data.image && (
											<img src={r.data.image.url} alt={r.data.image.alt}
												class="w-full h-full object-cover group-hover:opacity-80 transition-opacity" loading="lazy" />
										)}
									</div>
									<h4 class="font-serif text-[16px] font-semibold leading-[1.3] text-ink group-hover:text-accent-soft transition-colors">
										{r.data.title}
									</h4>
								</a>
							))}
						</div>
					</div>
				)}
			</div>

			<!-- TOC sidebar -->
			{tocHeadings.length > 0 && (
				<aside class="hidden lg:block col-span-3 col-start-10">
					<div class="sticky top-20">
						<div class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint mb-4 pb-3 border-b border-[var(--c-border)]">
							On This Page
						</div>
						<nav class="flex flex-col gap-2.5 toc-nav">
							{tocHeadings.map(h => (
								<a href={`#${h.slug}`}
									class={`text-[13px] leading-[1.4] text-muted hover:text-ink transition-colors toc-link toc-depth-${h.depth}`}
									data-heading={h.slug}>
									{h.text}
								</a>
							))}
						</nav>
					</div>
				</aside>
			)}
		</div>
	</article>

	<!-- Scroll spy -->
	<script>
		const links = document.querySelectorAll('.toc-link');
		const headings = Array.from(links).map(link => {
			const id = link.getAttribute('data-heading');
			return { el: document.getElementById(id || ''), link };
		}).filter(h => h.el);

		const observer = new IntersectionObserver(entries => {
			entries.forEach(entry => {
				const matching = headings.find(h => h.el === entry.target);
				if (!matching) return;
				if (entry.isIntersecting) {
					links.forEach(l => l.classList.remove('toc-active'));
					matching.link.classList.add('toc-active');
				}
			});
		}, { rootMargin: '-80px 0px -70% 0px' });

		headings.forEach(h => observer.observe(h.el));
	</script>

	<style>
		.toc-depth-3 { padding-left: 14px; font-size: 12px; }
		.toc-active { color: var(--c-accent) !important; }
	</style>

	<!-- JSON-LD: Article -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.pubDate.toISOString(),
		author: { "@type": "Person", name: post.data.author },
		publisher: { "@type": "Organization", name: "Margin" },
		articleSection: post.data.category,
	})} />
</Layout>
