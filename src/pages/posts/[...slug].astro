---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import SocialShare from '../../components/SocialShare.astro';
import BackLink from '../../components/BackLink.astro';
import Badge from '../../components/Badge.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/Icon.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SeriesBar from '../../components/SeriesBar.astro';
import config from '../../config.json';
import { formatDate } from '../../lib/dates';
import { estimateReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('posts');
const related = allPosts
	.filter(p => p.data.category === post.data.category && p.slug !== post.slug)
	.slice(0, 3);

// Reading time
const readMins = estimateReadingTime(post.body);

// TOC: only h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Series
const seriesPosts = post.data.series
	? allPosts.filter(p => p.data.series === post.data.series)
	: [];
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="max-w-[1280px] mx-auto px-5 md:px-8 py-10 md:py-14">
		<BackLink href="/">Back to home</BackLink>

		<div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-12">
			<!-- Main column -->
			<div class="col-span-12 lg:col-span-8 lg:col-start-1 min-w-0">
				<!-- Article header -->
				<header class="max-w-[680px] mb-12">
					<div class="flex items-center gap-3 mb-4">
						<Badge>{post.data.category}</Badge>
						<span class="font-mono text-[11px] text-faint">
							{formatDate(post.data.pubDate)}
						</span>
					</div>
					<h1 class="font-serif text-[28px] sm:text-[36px] md:text-[42px] font-bold leading-[1.15] tracking-tight text-ink mb-6">
						{post.data.title}
					</h1>
					<div class="flex items-center gap-3 pt-4 border-t border-[var(--c-border)]">
						{config.enableAuthor && (
							<div class="flex items-center gap-2.5 text-[13px] text-body">
								<Avatar name={post.data.author} size={26} />
								By <a href={`/author/${post.data.author}`} class="font-medium text-ink hover:text-accent-soft transition-colors">{post.data.author}</a>
							</div>
						)}
						<span class="text-faint">·</span>
						<span class="font-mono text-[11px] text-faint flex items-center gap-1">
							<Icon name="clock" size={12} stroke={true} />
							{readMins} min read
						</span>
						<span class="text-faint">·</span>
						<span class="font-mono text-[11px] text-faint flex items-center gap-1" id="busuanzi_container_page_pv" style="display:none">
							<Icon name="eye" size={12} stroke={true} />
							<span id="busuanzi_value_page_pv"></span> views
						</span>
						<!-- Tags -->
						{post.data.tags && post.data.tags.length > 0 && (
							<span class="hidden sm:flex items-center gap-1.5 ml-auto">
								{post.data.tags.map(tag => (
									<a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
										class="font-mono text-[10px] text-muted hover:text-accent-soft transition-colors">
										#{tag}
									</a>
								))}
							</span>
						)}
					</div>
				</header>

				<!-- Cover image -->
				{post.data.image && (
					<div class="max-w-[800px] mb-12 rounded-[3px] overflow-hidden">
						<img src={post.data.image.url} alt={post.data.image.alt}
							class="w-full h-auto object-cover max-h-[500px]" loading="eager" />
					</div>
				)}

				<!-- Article body -->
				<div class="prose mx-auto max-w-none" style="max-width:680px;" data-pagefind-body>
					<Content />
				</div>

				<!-- Series navigator -->
				{seriesPosts.length > 0 && post.data.series && (
					<div class="max-w-[680px] mt-16">
						<SeriesBar
							posts={seriesPosts}
							currentSlug={post.slug}
							seriesName={post.data.series}
						/>
					</div>
				)}

				<!-- Share -->
				<div class="max-w-[680px] mt-16 pt-8 border-t border-[var(--c-border)] flex items-center gap-4">
					<span class="text-[13px] text-body">Share:</span>
					<SocialShare />
				</div>

				<!-- Related -->
				{related.length > 0 && (
					<div class="max-w-[800px] mt-16">
						<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mb-5">Related Stories</div>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
							{related.map(r => (
								<PostCard post={r} />
							))}
						</div>
					</div>
				)}
			</div>

			<!-- TOC sidebar -->
			<TableOfContents headings={tocHeadings} />
		</div>
	</article>

	<!-- JSON-LD: Article -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.pubDate.toISOString(),
		author: { "@type": "Person", name: post.data.author },
		publisher: { "@type": "Organization", name: "Margin" },
		articleSection: post.data.category,
	})} />
</Layout>
