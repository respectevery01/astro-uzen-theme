---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import config from '../config.json';
---

<Layout title={`Search — ${config.siteTitle}`} description="Search all posts.">
	<PageHeader kicker="Search" title="Find a story" />

	<section class="max-w-[720px] mx-auto px-5 md:px-8 pb-16 md:pb-20">
		<div id="search-container">
			<div class="relative mb-8">
				<svg class="absolute left-4 top-1/2 -translate-y-1/2 text-faint" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
					<circle cx="11" cy="11" r="8" />
					<path d="m21 21-4.35-4.35" />
				</svg>
				<input type="text" id="search-input" placeholder="Search posts..."
					class="w-full pl-12 pr-4 py-3.5 bg-surface border border-[var(--c-border)] rounded-[3px] text-ink text-[15px] focus:border-accent focus:outline-none transition-colors" />
			</div>
			<div id="search-results" class="flex flex-col gap-2"></div>
			<div id="search-empty" class="text-muted text-sm text-center py-12">
				Start typing to search.
			</div>
		</div>
	</section>
</Layout>

<style>
	.search-result {
		padding: 14px 16px;
		border-radius: 3px;
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		transition: border-color 0.2s;
	}
	.search-result:hover { border-color: var(--c-accent); }
	.search-result-title {
		font-family: 'Fraunces', serif;
		font-size: 16px;
		font-weight: 600;
		color: var(--c-ink);
		margin-bottom: 4px;
	}
	.search-result-excerpt {
		font-size: 14px;
		color: var(--c-muted);
		line-height: 1.5;
	}
	.search-result-excerpt mark {
		background: color-mix(in srgb, var(--c-accent) 15%, transparent);
		color: var(--c-accent-soft);
		padding: 0 2px;
		border-radius: 2px;
	}
	.search-result-meta {
		font-family: 'JetBrains Mono', monospace;
		font-size: 11px;
		color: var(--c-faint);
		margin-top: 6px;
	}
</style>

<script>
	let pagefind = null;
	const input = document.getElementById('search-input') as HTMLInputElement;
	const results = document.getElementById('search-results')!;
	const empty = document.getElementById('search-empty')!;

	async function loadPagefind() {
		if (pagefind) return pagefind;
		try {
			const pagefindPath = '/pagefind/pagefind-ui.js';
			pagefind = await import(/* @vite-ignore */ pagefindPath);
			await pagefind.init();
		} catch (e) {
			empty.textContent = 'Search index not available in development. Run npm run build first.';
			return null;
		}
		return pagefind;
	}

	let debounceTimer: number;
	input.addEventListener('input', async () => {
		clearTimeout(debounceTimer);
		debounceTimer = setTimeout(async () => {
			const query = input.value.trim();
			if (!query) {
				results.innerHTML = '';
				empty.style.display = 'block';
				empty.textContent = 'Start typing to search.';
				return;
			}

			const pf = await loadPagefind();
			if (!pf) return;

			const search = await pf.search(query);
			const topResults = search.results.slice(0, 10);

			if (topResults.length === 0) {
				results.innerHTML = '';
				empty.style.display = 'block';
				empty.textContent = `No results for "${query}".`;
				return;
			}

			empty.style.display = 'none';
			const rendered = await Promise.all(
				topResults.map(r => r.data())
			);

			results.innerHTML = rendered.map(r => {
				const url = r.url.replace(/\.html$/, '/');
				return `
					<a href="${url}" class="search-result block">
						<div class="search-result-title">${r.meta?.title || 'Untitled'}</div>
						<div class="search-result-excerpt">${r.excerpt}</div>
						<div class="search-result-meta">${r.meta?.category || ''} ${r.meta?.pubDate ? '· ' + new Date(r.meta.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}</div>
					</a>
				`;
			}).join('');
		}, 200);
	});

	input.focus();
</script>
